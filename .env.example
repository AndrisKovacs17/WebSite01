PORT=3000

# Vesszővel elválasztva azok a domainek, ahonnan az űrlap beküldhető.
CORS_ORIGINS=https://biztor.hu,https://www.biztor.hu,http://localhost:3000,http://127.0.0.1:3000
# Lokális file:// teszthez true. Éles környezetben hagyja false-on.
ALLOW_FILE_ORIGIN=false

# SMTP küldés
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=iroda@example.com
SMTP_PASS=change-me
MAIL_FROM="Biztor Alkusz <iroda@example.com>"
MAIL_REPLY_TO=iroda@biztor.hu
MAIL_TO=iroda@biztor.hu

# Teszteléshez true: nem küld valódi e-mailt, csak JSON transportot használ.
MAIL_DRY_RUN=false

# Opcionális: rejtett másolat PDF-kérésekről.
LEAD_BCC=

# PDF útmutatók. Vagy lokális fájlt csatolunk, vagy publikus letöltési linket küldünk.
# Ha mindkettő ki van töltve, a levélben link is lesz és csatolmány is.
GUIDE_LAKAS_FILE=guides/lakasbiztositas-5-hiba-2026.pdf
GUIDE_LAKAS_URL=https://biztor.hu/pdf/lakasbiztositas-5-hiba-2026.pdf
GUIDE_KGFB_FILE=guides/kgfb-valtas-5-kerdes-2026.pdf
GUIDE_KGFB_URL=https://biztor.hu/pdf/kgfb-valtas-5-kerdes-2026.pdf
GUIDE_EGESZSEG_FILE=guides/egeszsegbiztositas-5-kerdes-2026.pdf
GUIDE_EGESZSEG_URL=https://biztor.hu/pdf/egeszsegbiztositas-5-kerdes-2026.pdf

# Egy IP + e-mail cím 10 perc alatt ennyiszer küldhet.
RATE_LIMIT_MAX=5
